<UserControl x:Class="RestaurantOnline.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantOnline.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titlu -->
        <TextBlock Grid.Row="0" Text="{Binding IsLoginMode, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Autentificare|inregistrare'}" 
                   FontSize="24" FontWeight="Bold" Margin="20,10"/>

        <!-- Formular -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Email -->
            <TextBlock Grid.Row="0" Text="Email:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,10" Padding="5"/>

            <!-- Parola -->
            <TextBlock Grid.Row="2" Text="Parola:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="3" Margin="0,0,0,10" Padding="5"/>

            <!-- Campuri pentru inregistrare -->
            <Grid Grid.Row="4" Visibility="{Binding IsLoginMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nume -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nume:" Margin="0,0,0,5"/>
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,5,10" Padding="5"/>

                <!-- Prenume -->
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Prenume:" Margin="0,0,0,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="5,0,0,10" Padding="5"/>

                <!-- Telefon -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Telefon:" Margin="0,0,0,5"/>
                <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,5,10" Padding="5"/>

                <!-- Adresa Livrare -->
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Adresa Livrare:" Margin="0,0,0,5"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="5,0,0,10" Padding="5"/>
            </Grid>

            <!-- Mesaj de eroare -->
            <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Foreground="Red" 
                       TextWrapping="Wrap" Margin="0,10" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <!-- Butoane -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <Button Content="{Binding IsLoginMode, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Autentificare|inregistrare'}" 
                        Command="{Binding LoginCommand}"
                        Width="120" Height="30" Margin="5" Background="#3498db" Foreground="White"/>
                <Button Content="{Binding IsLoginMode, Converter={StaticResource BoolToTextConverter}, ConverterParameter='inregistrare|Autentificare'}" 
                        Command="{Binding ToggleModeCommand}"
                        Width="120" Height="30" Margin="5" Background="#2ecc71" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl> 