<UserControl x:Class="RestaurantOnline.Views.OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantOnline.Views"
             xmlns:converters="clr-namespace:RestaurantOnline.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Titlu -->
        <TextBlock Grid.Row="0" Text="Gestionare Comenzi" 
                   FontSize="24" FontWeight="Bold" Margin="20,10"/>
        
        <!-- Butoane filtrare -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,10">
            <Button Content="Toate comenzile" Command="{Binding ArataComenziToateCommand}" 
                    Width="150" Height="30" Margin="0,0,10,0"
                    Background="#3498db" Foreground="White"/>
            
            <Button Content="Comenzi active" Command="{Binding ArataComenziActiveCommand}" 
                    Width="150" Height="30"
                    Background="#2ecc71" Foreground="White"/>
            
            <TextBlock Text="Comenzile sunt sortate descrescător după dată și oră." 
                       VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#666"/>
        </StackPanel>
        
        <!-- Lista Comenzi -->
        <ListView Grid.Row="2" ItemsSource="{Binding ComenziAfisate}" 
                  SelectedItem="{Binding ComandaSelectata}" 
                  Margin="10" BorderThickness="1" BorderBrush="#ccc">
            
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                </Style>
            </ListView.ItemContainerStyle>
            
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Expander Header="{Binding Status, StringFormat='Comanda {0}'}" 
                              Padding="5" Margin="0,5" 
                              IsExpanded="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}">
                        <Grid Margin="10,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                            <!-- ID Comanda -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" 
                                       FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OrderId}" 
                                       Margin="0,2"/>

                            <!-- Data Comanda -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Data:" 
                                       FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding OrderDate, StringFormat=dd/MM/yyyy HH:mm}" 
                                       Margin="0,2"/>
                                       
                            <!-- Ora estimată livrare -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Estimare livrare:" 
                                       FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding EstimatedDeliveryTime, StringFormat=dd/MM/yyyy HH:mm}" 
                                       Margin="0,2" Foreground="#E74C3C" FontWeight="SemiBold"/>

                            <!-- Client -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Client:" 
                                       FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" 
                                       Text="{Binding User.NumeComplet}" 
                                       Margin="0,2"/>

                            <!-- Status -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Status:" 
                                       FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status}" 
                                       Margin="0,2"/>

                            <!-- Total -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Total:" 
                                       FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" 
                                       Text="{Binding FinalAmount, StringFormat={}{0:F2} lei}" 
                                       Margin="0,2"/>

                            <!-- Butoane actiuni -->
                            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" 
                                        Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Detalii" Margin="0,0,10,0" Width="80" 
                                        Command="{Binding DataContext.DetaliiComandaCommand, 
                                        RelativeSource={RelativeSource AncestorType=ListView}}" 
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <!-- Schimbare status -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="15" Margin="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Schimbă status comandă:" 
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                
                <ComboBox Grid.Column="1" Margin="10,0" 
                          ItemsSource="{Binding StatusuriDisponibile}"
                          SelectedItem="{Binding SelectedStatus}"
                          IsEnabled="{Binding ComandaSelectata, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Width="200" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
                <Button Grid.Column="2" Content="Actualizează Status" 
                        Command="{Binding SchimbaStatusCommand}"
                        IsEnabled="{Binding ComandaSelectata, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Width="140" Height="30"/>
            </Grid>
        </Border>
        
        <!-- Bara de refresh jos -->
        <Grid Grid.Row="4" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Error message -->
            <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" 
                       Foreground="Red" VerticalAlignment="Center"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            
            <!-- Refresh button -->
            <Button Grid.Column="1" Content="Reîmprospătează lista" 
                    Command="{Binding RefreshCommand}"
                    Width="160" Height="30"/>
        </Grid>
    </Grid>
</UserControl> 