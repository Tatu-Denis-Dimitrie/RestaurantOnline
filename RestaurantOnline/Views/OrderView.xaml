<UserControl x:Class="RestaurantOnline.Views.OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantOnline.Views"
             xmlns:converters="clr-namespace:RestaurantOnline.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Titlu -->
        <TextBlock Grid.Row="0" Text="Gestionare Comenzi" 
                   FontSize="24" FontWeight="Bold" Margin="20,10"/>
        
        <!-- Lista Comenzi -->
        <ListView Grid.Row="1" ItemsSource="{Binding Comenzi}" 
                  SelectedItem="{Binding ComandaSelectata}" 
                  Margin="10" BorderThickness="1" BorderBrush="#ccc">
            
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Expander Header="{Binding Status, StringFormat='Comanda {0}'}" 
                              Padding="5" Margin="0,5" IsExpanded="False">
                        <Grid Margin="10,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                            <!-- ID Comanda -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" 
                                       FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OrderId}" 
                                       Margin="0,2"/>

                            <!-- Data Comanda -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Data:" 
                                       FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding OrderDate, StringFormat=dd/MM/yyyy HH:mm}" 
                                       Margin="0,2"/>

                            <!-- Client -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Client:" 
                                       FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding User.NumeComplet}" 
                                       Margin="0,2"/>

                            <!-- Stare -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Stare:" 
                                       FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status}" 
                                       FontWeight="SemiBold" Margin="0,2"/>

                            <!-- Valoare -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Valoare:" 
                                       FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" 
                                       Text="{Binding FinalAmount, StringFormat={}{0:F2} lei}" 
                                       Margin="0,2"/>

                            <!-- Produse -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Produse:" 
                                       FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,2"/>
                            <ItemsControl Grid.Row="5" Grid.Column="1" 
                                         ItemsSource="{Binding OrderDishes}" Margin="0,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{Binding Quantity}" Margin="0,0,5,0"/>
                                                    <TextBlock Text="x" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding Dish.Name}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                        </Grid>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
            
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        
        <!-- Eroare -->
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" 
                   Foreground="Red" FontWeight="SemiBold" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        
        <!-- Panou pentru schimbarea statusului -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15" Margin="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Schimbă status comandă:" 
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                
                <ComboBox Grid.Column="1" Margin="10,0" 
                          ItemsSource="{Binding StatusuriDisponibile}"
                          SelectedItem="{Binding SelectedStatus}"
                          IsEnabled="{Binding ComandaSelectata, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Width="200" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
                <Button Grid.Column="2" Content="Actualizează Status" 
                        Command="{Binding SchimbaStatusCommand}"
                        IsEnabled="{Binding ComandaSelectata, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Width="140" Height="30"/>
            </Grid>
        </Border>
        
        <!-- Butoane -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,20,20">
            <Button Command="{Binding RefreshCommand}" Content="Reîmprospătează" 
                    Width="120" Height="30" Margin="10,0"/>
            <Button Command="{Binding DetaliiComandaCommand}" Content="Detalii comandă" 
                    Width="120" Height="30" Margin="10,0"
                    IsEnabled="{Binding ComandaSelectata, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl> 