<UserControl x:Class="RestaurantOnline.Views.AddMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantOnline.Views"
             xmlns:viewmodels="clr-namespace:RestaurantOnline.ViewModels"
             xmlns:converters="clr-namespace:RestaurantOnline.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        
        <!-- Template pentru afișarea unui preparat -->
        <DataTemplate x:Key="DishItemTemplate">
            <Border Margin="5" BorderThickness="1" BorderBrush="#E0E0E0" 
                    CornerRadius="5" Background="White"
                    Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Dish.Name}" 
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="{Binding Dish.Price, StringFormat={}{0:F2} lei}" 
                               Foreground="#2E7D32"/>
                    <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" 
                            Content="+" Width="40" Height="30" 
                            Command="{Binding DataContext.AddDishCommand, 
                            RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
        
        <!-- Template pentru afișarea unui preparat selectat -->
        <DataTemplate x:Key="SelectedDishItemTemplate">
            <Border Margin="5" BorderThickness="1" BorderBrush="#E0E0E0" 
                    CornerRadius="5" Background="#F5F5F5">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Dish.Name}" 
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="{Binding Dish.Price, StringFormat={}{0:F2} lei}" 
                               Foreground="#2E7D32"/>
                    
                    <!-- Control pentru cantitate -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" 
                                Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                        <TextBox Text="{Binding Quantity}" Width="50" 
                                 VerticalContentAlignment="Center" 
                                 Margin="0,0,0,0" TextAlignment="Center"/>
                    </StackPanel>
                    
                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" 
                            Content="X" Width="40" Height="30" 
                            Background="#e74c3c" Foreground="White"
                            Command="{Binding DataContext.RemoveDishCommand, 
                            RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Titlul paginii -->
        <TextBlock Grid.Row="0" Text="Adaugă meniu nou" 
                   FontSize="24" FontWeight="Bold" Margin="20,20,20,10"/>
        
        <!-- Formular adăugare meniu -->
        <Grid Grid.Row="1" Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Partea stângă - Proprietăți meniu -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Eroare -->
                <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="SemiBold"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                           Margin="0,0,0,10" TextWrapping="Wrap"/>
                
                <!-- Numele meniului -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Numele meniului:" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                
                <!-- Categorie -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Categorie:" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Categories}" 
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"/>
                </StackPanel>
                
                <!-- Lista de preparate selectate -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Preparate selectate:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Număr preparate:" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding SelectedDishes.Count}"/>
                        <TextBlock Text=" | Preț total:" FontWeight="SemiBold" Margin="20,0,10,0"/>
                        <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:F2} lei}" 
                                   Foreground="#2E7D32"/>
                    </StackPanel>
                    
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding SelectedDishes}" 
                                  ItemTemplate="{StaticResource SelectedDishItemTemplate}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <Border BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="5">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Grid>
            
            <!-- Partea dreaptă - Lista de preparate disponibile -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Adaugă preparate în meniu:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                
                <!-- Căutare preparate -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                              Height="35" VerticalContentAlignment="Center"
                             Padding="10,0" Margin="0,0,5,0"/>
                    <Button Grid.Column="1" Content="Caută" Height="35"
                            Command="{Binding SearchCommand}"/>
                </Grid>
                
                <!-- Lista de preparate disponibile -->
                <Border Grid.Row="2" BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AllDishes}" 
                                      ItemTemplate="{StaticResource DishItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        
        <!-- Butoane acțiuni -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="20">
            <Button Content="Anulează" Command="{Binding CancelCommand}" 
                    Background="#e74c3c" Foreground="White"/>
            <Button Content="Salvează" Command="{Binding SaveCommand}" 
                    Background="#2ecc71" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl> 