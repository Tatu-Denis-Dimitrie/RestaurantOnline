<UserControl x:Class="RestaurantOnline.Views.EditDishView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantOnline.Views"
             xmlns:viewmodels="clr-namespace:RestaurantOnline.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Titlul paginii -->
        <TextBlock Grid.Row="0" Text="Editare preparat" 
                   FontSize="24" FontWeight="Bold" Margin="20,20,20,10"/>
        
        <!-- Selector preparat -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <ComboBox Grid.Column="0" 
                      ItemsSource="{Binding AllDishes}" 
                      SelectedItem="{Binding SelectedDish}"
                      DisplayMemberPath="Name"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="Name"
                      Height="35"/>
            
            <Button Grid.Column="1" Content="Încarcă detalii" 
                    Command="{Binding LoadDishDetailsCommand}" 
                    Margin="10,0,0,0"/>
        </Grid>
        
        <!-- Formular editare preparat -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,0">
            <StackPanel>
                <!-- Eroare -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="SemiBold"
                          Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                          Margin="0,0,0,10" TextWrapping="Wrap"/>
                
                <!-- ID-ul preparatului (Hidden) -->
                <TextBox Text="{Binding DishId}" Visibility="Collapsed"/>
                
                <!-- Numele preparatului -->
                <TextBlock Text="Numele preparatului:" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                
                <!-- Pret -->
                <TextBlock Text="Preț (lei):" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>
                
                <!-- Gramaj portie -->
                <TextBlock Text="Cantitate porție (grame):" FontWeight="SemiBold"/>
                <TextBox Text="{Binding PortionSizeGrams, UpdateSourceTrigger=PropertyChanged}"/>
                
                <!-- Cantitate in stoc -->
                <TextBlock Text="Cantitate totală (grame):" FontWeight="SemiBold"/>
                <TextBox Text="{Binding TotalQuantityGrams, UpdateSourceTrigger=PropertyChanged}"/>
                
                <!-- Categorie -->
                <TextBlock Text="Categorie:" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Categories}" 
                          SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name"/>
                
                <!-- Alergeni -->
                <TextBlock Text="Alergeni:" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <ListBox ItemsSource="{Binding AllAllergens}" 
                        SelectionMode="Multiple" Height="120"
                        Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" Margin="5,2" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <!-- Nume imagine -->
                <TextBlock Text="Numele imaginii:" FontWeight="SemiBold"/>
                <TextBox Text="{Binding PhotoName, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,5,0,10"/>
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- Butoane actiuni -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="20">
            <Button Content="Anulează" Command="{Binding CancelCommand}" 
                    Background="#e74c3c" Foreground="White"/>
            <Button Content="Salvează" Command="{Binding SaveCommand}" 
                    Background="#2ecc71" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl> 