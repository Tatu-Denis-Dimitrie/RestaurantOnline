<UserControl x:Class="RestaurantOnline.Views.MyAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantOnline.Views"
             xmlns:converters="clr-namespace:RestaurantOnline.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Antet -->
        <Border Grid.Row="0" Background="#F8F8F8" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Contul meu" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding UserFullName}" FontSize="16" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding UserEmail}" Foreground="#666666"/>
            </StackPanel>
        </Border>
        
        <!-- Conținut principal - Istoric comenzi -->
        <Grid Grid.Row="1" Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Istoric comenzi" 
                       FontSize="18" FontWeight="SemiBold"/>
            
            <Button Grid.Column="1" Content="Reîmprospătează" 
                    Command="{Binding RefreshCommand}" 
                    Padding="10,5" />
        </Grid>
        
        <!-- Listă comenzi -->
        <Border Grid.Row="2" Margin="20,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Comenzi}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#EEEEEE" BorderThickness="1" 
                                    CornerRadius="5" Margin="0,0,0,10" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Număr comandă -->
                                        <TextBlock Grid.Column="0" Text="{Binding OrderId, StringFormat=Comanda #{0}}" 
                                                   FontWeight="Bold" Margin="0,0,20,0"/>
                                        
                                        <!-- Dată comandă -->
                                        <TextBlock Grid.Column="1" Text="{Binding OrderDate, StringFormat=d MMM yyyy HH:mm}" 
                                                   Foreground="#666666"/>
                                        
                                        <!-- Status comandă -->
                                        <Border Grid.Column="2" Background="#E3F2FD" CornerRadius="4" 
                                                Padding="10,3" Margin="0,0,15,0">
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="#1976D2"/>
                                        </Border>
                                        
                                        <!-- Buton detalii -->
                                        <Grid Grid.Column="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Button Grid.Column="0" Content="Detalii" 
                                                    Command="{Binding DataContext.ViewOrderDetailsCommand, 
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Background="#2196F3" Foreground="White" 
                                                    Padding="10,3" Margin="0,0,5,0" />
                                            
                                            <Button Grid.Column="1" Content="Anulare" 
                                                    Command="{Binding DataContext.CancelOrderCommand, 
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Background="#F44336" Foreground="White" 
                                                    Padding="10,3">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="anulata">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                    
                                    <!-- Ora estimativă de livrare -->
                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" 
                                                  Text="Estimare livrare:" 
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,10,0"/>
                                                  
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding EstimatedDeliveryTime, StringFormat=d MMM yyyy HH:mm}"
                                                      Foreground="#E74C3C"
                                                      FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        
        <!-- Mesaj de eroare sau încărcare -->
        <Border Grid.Row="2" Background="#FFF3F3" BorderBrush="#FFCDD2" 
                BorderThickness="1" Padding="15" Margin="20" 
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl> 