<UserControl x:Class="RestaurantOnline.Views.ComenziView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantOnline.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Titlu -->
        <TextBlock Grid.Row="0" Text="Comenzi" FontSize="24" FontWeight="Bold" Margin="20,10"/>
        
        <!-- Lista de comenzi -->
        <ListView Grid.Row="1" ItemsSource="{Binding Comenzi}" Margin="20,10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Expander Header="{Binding IdComanda}" Margin="5" IsExpanded="False">
                        <Grid Margin="5,10,5,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Informații generale despre comandă -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DataComanda, StringFormat=dd/MM/yyyy HH:mm}" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,5,0,0">
                                        <Run Text="Client: "/>
                                        <Run Text="{Binding Utilizator.Nume}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Utilizator.Prenume}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,5,0,0">
                                        <Run Text="Adresa: "/>
                                        <Run Text="{Binding Utilizator.Adresa}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,5,0,0">
                                        <Run Text="Telefon: "/>
                                        <Run Text="{Binding Utilizator.Telefon}"/>
                                    </TextBlock>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border Background="{Binding Stare, Converter={StaticResource StareToColorConverter}}" 
                                            Padding="8,3" CornerRadius="4" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Stare}" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Transport: " Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Transport, StringFormat={}{0:N2} RON}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                        <TextBlock Text="Total: " Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding ValoareFinala, StringFormat={}{0:N2} RON}" FontWeight="Bold" FontSize="14"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Lista de preparate din comandă -->
                            <Border Grid.Row="1" Margin="0,15,0,0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Conținutul comenzii:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding ComandaPreparate}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Grid.Column="0" Text="{Binding Cantitate}" 
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Preparat.Denumire}" 
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="x" VerticalAlignment="Center" 
                                                               Margin="10,0"/>
                                                    <TextBlock Grid.Column="3" 
                                                               Text="{Binding Preparat.Pret, StringFormat={}{0:N2} RON}" 
                                                               VerticalAlignment="Center" 
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl> 