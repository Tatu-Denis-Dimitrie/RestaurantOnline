<Window x:Class="RestaurantOnline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"    
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantOnline"
        xmlns:viewmodels="clr-namespace:RestaurantOnline.ViewModels"
        xmlns:views="clr-namespace:RestaurantOnline.Views"
        mc:Ignorable="d"
        Title="Restaurant Online - Gestiune" Height="650" Width="1000">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DishViewModel}">
            <views:DishView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:UtilizatoriViewModel}">
            <views:UsersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ComenziViewModel}">
            <views:OrderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AuthVM}">
            <views:AuthView />
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2c3e50" Height="50">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Butoane de navigare -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10">
                <TextBlock Text="RESTAURANT ONLINE" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button Content="Preparate" Width="100" Margin="5,0" Command="{Binding NavigateToPreparateCommand}" Foreground="White" Background="#3498db" BorderBrush="#3498db"/>
                <Button Content="Utilizatori" Width="100" Margin="5,0" Command="{Binding NavigateToUtilizatoriCommand}" Foreground="White" Background="#3498db" BorderBrush="#3498db"/>
                <Button Content="Comenzi" Width="100" Margin="5,0" Command="{Binding NavigateToComenziCommand}" Foreground="White" Background="#3498db" BorderBrush="#3498db"/>
            </StackPanel>

                <!-- Buton Login/Sign Up -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10">
                    <Button Content="Login" 
                            Width="100" Margin="5,0" Command="{Binding NavigateToAutentificareCommand}" 
                            Foreground="White" Background="#e74c3c" BorderBrush="#e74c3c"/>
                    <Button Content="Sign in" 
                            Width="100" Margin="5,0" Command="{Binding NavigateToInregistrareCommand}" 
                            Foreground="White" Background="#2ecc71" BorderBrush="#2ecc71"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
