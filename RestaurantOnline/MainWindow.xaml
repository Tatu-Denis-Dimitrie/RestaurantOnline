<Window x:Class="RestaurantOnline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"    
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantOnline"
        xmlns:viewmodels="clr-namespace:RestaurantOnline.ViewModels"
        xmlns:views="clr-namespace:RestaurantOnline.Views"
        xmlns:converters="clr-namespace:RestaurantOnline.Converters"
        mc:Ignorable="d"
        Title="Restaurant Online - Gestiune" Height="650" Width="1000">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DishViewModel}">
            <views:DishView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:UtilizatoriViewModel}">
            <views:UsersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ComenziViewModel}">
            <views:OrderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AuthVM}">
            <views:AuthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AddDishViewModel}">
            <views:AddDishView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AdminViewModel}">
            <views:AdminView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CategoryViewModel}">
            <views:CategoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AllergenViewModel}">
            <views:AllergenView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MenuViewModel}">
            <views:MenuView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MyAccountViewModel}">
            <views:MyAccountView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CartViewModel}">
            <views:CartView />
        </DataTemplate>
        
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel vertical pentru meniul din stanga -->
        <Border Grid.Column="0" Background="#2c3e50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Titlu aplicatie -->
                <TextBlock Grid.Row="0" Text="RESTAURANT ONLINE" FontSize="18" Foreground="White" 
                           HorizontalAlignment="Center" Margin="10,20,10,30" TextWrapping="Wrap" TextAlignment="Center"/>
                
                <!-- Butoane de navigare verticale -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="20,10">
                    <Button Content="Preparate" Height="40" Margin="0,5" Command="{Binding NavigateToDishesCommand}" 
                            Foreground="White" Background="#3498db" BorderBrush="#3498db"/>
                    
                    <Button Content="Meniuri" Height="40" Margin="0,5" Command="{Binding NavigateToMenusCommand}" 
                            Foreground="White" Background="#3498db" BorderBrush="#3498db"/>
                    
                    <!-- Buton Coș cumpărături -->
                    <Button Content="Coș cumpărături" Height="40" Margin="0,5" Command="{Binding NavigateToCartCommand}" 
                            Foreground="White" Background="#f39c12" BorderBrush="#f39c12"
                            Visibility="{Binding IsClientLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    
                    <!-- Buton Administrare (vizibil doar pentru angajati) -->
                    <Button Content="Administrare" Height="40" Margin="0,5" Command="{Binding NavigateToAdminCommand}" 
                            Foreground="White" Background="#9b59b6" BorderBrush="#9b59b6"
                            Visibility="{Binding IsEmployeeLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    
                    <!-- Buton Contul Meu (vizibil doar pentru clienti autentificati) -->
                    <Button Content="Contul Meu" Height="40" Margin="0,5" Command="{Binding NavigateToMyAccountCommand}"
                            Visibility="{Binding IsClientLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Foreground="White" Background="#f39c12" BorderBrush="#f39c12"/>
                </StackPanel>
                
                <!-- Butoane autentificare jos (vizibile doar cand utilizatorul nu e autentificat) -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="20,10,20,20">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Login" Height="40" Margin="0,5" Command="{Binding NavigateToLoginCommand}" 
                            Foreground="White" Background="#e74c3c" BorderBrush="#e74c3c"/>
                    <Button Content="Sign in" Height="40" Margin="0,5" Command="{Binding NavigateToRegisterCommand}" 
                            Foreground="White" Background="#2ecc71" BorderBrush="#2ecc71"/>
                </StackPanel>
                
                <!-- Buton Logout (vizibil doar cand utilizatorul e autentificat) -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="20,10,20,20"
                            Visibility="{Binding IsUserLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding UserDisplayName}" Foreground="White" 
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,5"/>
                    <Button Content="Deconectare" Height="40" Margin="0,5" Command="{Binding LogoutCommand}" 
                            Foreground="White" Background="#e74c3c" BorderBrush="#e74c3c"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Continutul principal -->
        <Border Grid.Column="1" Background="White" Margin="0">
            <ContentControl Content="{Binding CurrentViewModel}" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"/>
        </Border>
    </Grid>
</Window>
